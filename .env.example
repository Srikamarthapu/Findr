VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Preferred server-only Supabase credential for account deletion.
# A legacy service-role JWT is accepted as a fallback. Never expose either.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider credentials. Never prefix these with VITE_.
NVIDIA_NIM_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional. Unauthenticated DataSF reads work, but an app token gives this
# server-side catalog sync its own request pool.
DATASF_APP_TOKEN=

# Optional provider/model overrides.
NVIDIA_PRO_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_FLASH_MODEL=deepseek-ai/deepseek-v4-flash
ZAI_MODEL=glm-5-turbo
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
FINDR_FIRST_SIGNAL_TIMEOUT_MS=12000
FINDR_TOTAL_TIMEOUT_MS=45000
